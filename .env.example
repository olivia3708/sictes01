# ==============================================================================
# BERMUDA PORTAL - SCALINGO CLOUD GATEWAY ENVIRONMENT TEMPLATE
# Platform: Scalingo PaaS (osc-fr1 / osc-secnum-fr1) + Cloudflare Edge
# ==============================================================================

# [Recommended for Edge Tuning] Cloudflare API Token with Zone/DNS/Ruleset Edit permissions
CLOUDFLARE_API_TOKEN=

# [Optional] Explicit Cloudflare Zone ID (Auto-discovered if left empty)
CLOUDFLARE_ZONE_ID=

# [Recommended for Auto-Provisioning] Scalingo Personal API Token (tk-us-...)
SCALINGO_API_TOKEN=

# [Optional] Custom Domain routed through Cloudflare Edge (e.g. sub.yourdomain.com or DigitalPlat domain)
CUSTOM_DOMAIN=

# [Optional] Master Secret Seed for Deterministic Key Derivation (Auto-generated & persisted if empty)
BERMUDA_MASTER_KEY=

# [Optional] Scalingo Deployment Region (osc-fr1 for Paris Outscale, osc-secnum-fr1 for SecNumCloud)
BERMUDA_REGION=osc-fr1
